# Ringkasku — environment template (OPTIONAL)
# The app is zero-build: it reads config from public/firebase-config.js.
# These variables are only used if you add a build step (e.g. Vite) that
# injects import.meta.env — see README.md "Deploy with a real project".
# NEVER put real keys in this file; copy it to .env and keep .env out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_RECAPTCHA_SITE_KEY=
